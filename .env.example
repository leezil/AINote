# Optional: absolute path for uploads (default: .data locally, /tmp/ainote-data on Vercel)
# DOCUMENT_STORE_ROOT=

# Google AI Studio / Gemini (server only — never expose to the browser)
GEMINI_API_KEY=

# Vercel Blob (권장: Vercel 배포 시 문서/목록이 인스턴스 간 공유됨). 미설정 시 로컬 .data 또는 /tmp 사용.
# BLOB_READ_WRITE_TOKEN=

# Optional: override default workspace id (future: per-user tenant)
DEFAULT_WORKSPACE_ID=local

# Optional model id (default: gemini-2.5-flash). 예: gemini-2.5-flash-lite, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Client-visible default (must match server DEFAULT_WORKSPACE_ID for solo use)
NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=local
